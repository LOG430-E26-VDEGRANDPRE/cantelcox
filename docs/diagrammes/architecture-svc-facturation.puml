@startuml
skinparam componentStyle uml2
skinparam backgroundColor #F5F9F5
skinparam defaultFontName Arial

skinparam package {
    BackgroundColor White
    BorderColor #2D6A8E
    BorderThickness 1.5
    FontStyle bold
}

skinparam component {
    BackgroundColor White
    BorderColor #2D6A8E
    BorderThickness 1
}

skinparam arrowColor #9E2A3A

skinparam linetype polyline

title Architecture Hexagonale - svc-facturation (Synchrones & Événements)

package "Adapteurs d'entrée" as AdapteurE  {
    component "API REST (Flask)\n(Controllers: BillCycle, CustomerBill, Payment, Usage)" as WebController
    component "Kafka Consumer\n(Messaging)" as EventConsumer
}

package "Application (Cas d'utilisation)" as App {
    component "Write Use Cases\n(Commandes)" as WriteUC
    component "Read Use Cases\n(Requêtes)" as ReadUC
}

package "Domaine (cœur pur)" as Domaine #D5E8D4 {
    component "CustomerBill" as CustomerBill
    component "BillLine" as BillLine
    component "BillCycle" as BillCycle
    component "Payment" as Payment
    component "Usage" as Usage
    
    CustomerBill *-- BillLine : contient
}

package "Adapters de sortie" as AdaptesO {
    component "SQLAlchemy Adapter\n(MySQL Persistence + Outbox)" as SQLAdapter
    component "Kafka Publisher\n(kafka_producer)" as KafkaPublisher
}

' --- Relations Adapteurs In (Synchrone) -> App ---
WebController --> WriteUC : POST, PUT, DELETE\n(Créer factures, paiements, etc.)
WebController --> ReadUC : GET\n(Consulter factures et usage)

' --- Relations Adapteurs In (Événementiel) -> App ---
EventConsumer --> WriteUC : DoInvoicing\n(Générer la facture du cycle)
EventConsumer --> WriteUC : AbusUsage\n(Gérer l'usage abusif)

' --- Relations App -> Domaine ---
WriteUC .down.> CustomerBill
WriteUC .down.> Payment
WriteUC .down.> Usage 
WriteUC .down.> BillCycle 

ReadUC .down.> CustomerBill
ReadUC .down.> Usage

' --- Relations App -> Adapteurs de sortie ---
WriteUC --> SQLAdapter : Sauvegarde en BD (DAO + Outbox)
ReadUC --> SQLAdapter : Interroge la BD (DAO)

WriteUC --> KafkaPublisher : Publie (via Outbox)

@enduml
