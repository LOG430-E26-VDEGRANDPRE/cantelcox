@startuml
skinparam componentStyle uml2
skinparam backgroundColor #F5F9F5
skinparam defaultFontName Arial

skinparam package {
    BackgroundColor White
    BorderColor #2D6A8E
    BorderThickness 1.5
    FontStyle bold
}

skinparam component {
    BackgroundColor White
    BorderColor #2D6A8E
    BorderThickness 1
}

skinparam arrowColor #9E2A3A

' skinparam linetype polyline

title Architecture Hexagonale - svc-commandes

package "Adapteurs d'entrée" as AdapteurE  {
    component "API REST (Flask)\n(HTTP)" as WebController
    component "Kafka Consumer\n(Messaging)" as EventConsumer
}

package "Application" as App {
    component "PlaceOrder\nUseCase" as PlaceOrderUC
    component "UpdateOrder\nUseCase" as UpdateOrderUC
    component "DeleteOrder\nUseCase" as DeleteOrderUC
    component "GetOrder\nUseCase" as GetOrderUC
}

package "Domaine (cœur pur)" as Domaine #D5E8D4 {
    component "Order" as Order
    component "OrderItem" as OrderItem
    component "Product" as Product
    
    Order *-- OrderItem : contient
}

package "Adapters de sortie" as AdaptesO {
    component "SQLAlchemy Adapter\n(MySQL Persistence + Outbox)" as SQLAdapter
    component "Redis Adapter\n(Read Model)" as RedisAdapter
    component "Outbox Publisher\n(kafka_producer)" as KafkaPublisher
}


' --- Relations Adapteurs In (Synchrone) -> App ---
WebController --> PlaceOrderUC : POST /orders\n(Initie transaction et Saga)
WebController --> UpdateOrderUC : PUT /orders
WebController --> DeleteOrderUC : DELETE /orders
WebController --> GetOrderUC : GET /orders

' --- Relations Adapteurs In (Événementiel) -> App ---
EventConsumer --> UpdateOrderUC : OrderSagaSubmitted\n(Confirme la saga)\n\nOrderValidationsOk\n(Valide la commande)
' EventConsumer --> UpdateOrderUC : 
EventConsumer --> DeleteOrderUC : PaymentDelinquant\n(Annule la commande)

' --- Relations App -> Domaine ---
PlaceOrderUC .down.> Order 
PlaceOrderUC .down.> Product 
UpdateOrderUC .down.> Order 
DeleteOrderUC .down.> Order 
GetOrderUC .down.> Order 

' --- Relations App -> Adapteurs de sortie (Ports sortants implicites) ---
PlaceOrderUC --> SQLAdapter : Utilise
UpdateOrderUC --> SQLAdapter : Utilise
DeleteOrderUC --> SQLAdapter : Utilise

PlaceOrderUC ----> RedisAdapter : Met à jour cache
UpdateOrderUC ----> RedisAdapter : Met à jour cache
DeleteOrderUC ----> RedisAdapter : Supprime cache
GetOrderUC ----> RedisAdapter : Utilise (Read)

PlaceOrderUC --> KafkaPublisher : Publie (via Outbox)
UpdateOrderUC --> KafkaPublisher : Publie (via Outbox)

@enduml