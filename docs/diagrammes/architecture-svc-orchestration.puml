@startuml
skinparam componentStyle uml2
skinparam backgroundColor #F5F9F5
skinparam defaultFontName Arial

skinparam package {
    BackgroundColor White
    BorderColor #2D6A8E
    BorderThickness 1.5
    FontStyle bold
}

skinparam component {
    BackgroundColor White
    BorderColor #2D6A8E
    BorderThickness 1
}

skinparam arrowColor #9E2A3A

skinparam linetype polyline

title Architecture Hexagonale - svc-orchestration (Synchrones & Événements)

package "Adapteurs d'entrée" as AdapteurE  {
    component "API REST (Flask)\n(OrderSagaController)" as WebController
    component "Kafka Consumer\n(Messaging)" as EventConsumer
}

package "Application (Saga & Orchestration)" as App {
    component "SagaOrchestrator\n(Gestionnaire d'état)" as SagaOrchestrator
    component "Handlers\n(VerifyBuyer, DecreaseStock, etc.)" as EventHandlers
}

package "Domaine (cœur pur)" as Domaine #D5E8D4 {
    component "OrderSagaState\n(État de la transaction distribuée)" as SagaState
}

package "Adapters de sortie" as AdaptesO {
    component "SQLAlchemy Adapter\n(MySQL Persistence + Outbox)" as SQLAdapter
    component "Kafka Publisher\n(kafka_producer)" as KafkaPublisher
}

' --- Relations Adapteurs In (Synchrone) -> App ---
WebController --> SagaOrchestrator : POST (Initier Saga), GET (Statut)

' --- Relations Adapteurs In (Événementiel) -> App ---
EventConsumer --> EventHandlers : BuyerVerified, StockDecreased, etc.\n(Réponses des autres microservices)

' --- Relations App -> Domaine ---
SagaOrchestrator .down.> SagaState : Gère les transitions d'état
EventHandlers --> SagaOrchestrator : Soumet le résultat pour faire avancer la Saga

' --- Relations App -> Adapteurs de sortie ---
SagaOrchestrator --> SQLAdapter : Sauvegarde l'état de la Saga (DAO + Outbox)
SagaOrchestrator --> KafkaPublisher : Publie la prochaine commande à exécuter (via Outbox)

@enduml
