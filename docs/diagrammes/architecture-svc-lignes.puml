@startuml
skinparam componentStyle uml2
skinparam backgroundColor #F5F9F5
skinparam defaultFontName Arial

skinparam package {
    BackgroundColor White
    BorderColor #2D6A8E
    BorderThickness 1.5
    FontStyle bold
}

skinparam component {
    BackgroundColor White
    BorderColor #2D6A8E
    BorderThickness 1
}

skinparam arrowColor #9E2A3A

' skinparam linetype polyline

title Architecture Hexagonale - svc-lignes (Synchrones & Événements)

package "Adapteurs d'entrée" as AdapteurE  {
    component "API REST\n(Activation, Usage)" as WebController
    component "Kafka Consumer\n(Messaging)" as EventConsumer
}

package "Application (Cas d'utilisation)" as App {
    component "ActivateLines\nUseCase" as ActivateLinesUC
    component "RecordUsage\nUseCase" as RecordUsageUC
    component "GetUsage\nUseCase" as GetUsageUC
    component "DeleteUsage\nUseCase" as DeleteUsageUC
    component "SimulateUsage\nUseCase" as SimulateUsageUC
}

package "Domaine (cœur pur)" as Domaine #D5E8D4 {
    component "Subscriber" as Subscriber
    component "UsageRecord" as UsageRecord
    component "Value Objects\n(IMSI, PLMN, etc.)" as ValueObjects
    
    Subscriber *-- UsageRecord : possède
}

package "Adapters de sortie" as AdaptesO {
    component "Free5GC Adapter\n(Réseau Télécom Core 5G)" as Free5GCAdapter
    component "MongoDB Adapter\n(Persistence + Outbox)" as MongoAdapter
    component "Kafka Publisher\n(kafka_producer)" as KafkaPublisher
    
    package "Anti-Corruption Layer (ACL)" as ACL {
        component "HLR/HSS Adapter\n(Provisionnement MSISDN)" as HLRAdapter
        component "PortabilityHub Adapter\n(Port-in / Port-out)" as PortabilityAdapter
    }
}

package "Systèmes Externes Fournis" as SystemesExternes {
    node "HLR/HSS" as HLRSystem
    node "PortabilityHub" as PortabilitySystem
}

' --- Relations Adapteurs In (Synchrone) -> App ---
WebController ---> ActivateLinesUC : POST /activations
WebController ---> RecordUsageUC : POST /usage
WebController ---> GetUsageUC : GET /usage
WebController ---> SimulateUsageUC : POST /simulate
WebController ---> DeleteUsageUC : DELETE /usage

' --- Relations Adapteurs In (Événementiel) -> App ---
EventConsumer ---> ActivateLinesUC : DoProvisionActions\n(Orchestration de la Saga)
EventConsumer ---> DeleteUsageUC : AbusUsage\n(Révocation / Blocage)

' --- Relations App -> Domaine ---
ActivateLinesUC .down..> Subscriber
RecordUsageUC .down..> UsageRecord : Enregistre
GetUsageUC .down..> UsageRecord
DeleteUsageUC .down..> Subscriber

' --- Relations App -> Adapteurs de sortie ---
ActivateLinesUC -down--> Free5GCAdapter : Provisionne la ligne (WebUI)
DeleteUsageUC ---> Free5GCAdapter : Révoque l'accès

ActivateLinesUC ---> HLRAdapter : Gère MSISDN
ActivateLinesUC ---> PortabilityAdapter : Vérifie portabilité

HLRAdapter ---> HLRSystem : APIs Spécifiques
PortabilityAdapter ---> PortabilitySystem : APIs Spécifiques

ActivateLinesUC ---> MongoAdapter : Sauvegarde données + Outbox
RecordUsageUC ---> MongoAdapter : Sauvegarde données + Outbox
GetUsageUC ---> MongoAdapter : Interroge les données

ActivateLinesUC ---> KafkaPublisher : Publie statut (ServiceProvisionOk/Ko)
RecordUsageUC ---> KafkaPublisher : Publie alerte abus si dépassement

@enduml
